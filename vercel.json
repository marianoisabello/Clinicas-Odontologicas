{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/auth/google/callback",
      "destination": "/api/auth-google-callback"
    },
    {
      "source": "/auth/google/start",
      "destination": "/api/backend"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
